{
  "name": "luxury-smile-architects",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Luxury Smile Architects — clínica de odontología estética boutique del Dr. Martín Prato. Sitio premium bilingüe (ES/EN).",
  "scripts": {
    "predev": "node scripts/gen-media-index.mjs",
    "dev": "vite",
    "prebuild": "node scripts/validate-content.mjs && node scripts/gen-media-index.mjs && node scripts/gen-og-images.mjs && node scripts/vendor-cms.mjs && node scripts/gen-cms-config.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "media-index": "node scripts/gen-media-index.mjs",
    "compress-videos": "node scripts/compress-videos.mjs",
    "postbuild": "node scripts/prerender.mjs",
    "og-images": "node scripts/gen-og-images.mjs",
    "validate-schema": "node scripts/validate-schema.mjs",
    "cms-config": "node scripts/gen-cms-config.mjs",
    "validate-content": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.4",
    "embla-carousel": "8.6.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "^13.2.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.0.2",
    "i18next-http-backend": "^4.0.2",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-phone-number-input": "^3.4.18",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@sveltia/cms": "^0.210.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^7.1.5",
    "vite-plugin-sri3": "^1.3.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
